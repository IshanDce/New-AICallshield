# AICallShield Backend Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (for Whisper STT, GPT, TTS)
OPENAI_API_KEY=

# Google Gemini API Key (alternative LLM)
GEMINI_API_KEY=

# Firebase
FIREBASE_CREDENTIALS=serviceAccount.json
FIREBASE_STORAGE_BUCKET=aicallshield.appspot.com

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
