# AICallShield Backend Environment Variables
# Copy this file to .env and fill in your values

# OpenAI API Key (for Whisper STT and GPT)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (alternative LLM)
GEMINI_API_KEY=your_gemini_api_key_here

# ── ElevenLabs TTS ────────────────────────────────────────────────────────────
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice IDs from Voice Lab (already set as defaults in code, override here if needed)
ELEVENLABS_VOICE_ASSISTANT=your_elevenlabs_voice_id_here   # male  – main AI screening voice
ELEVENLABS_VOICE_ALERT=your_elevenlabs_voice_alert_id_here       # female – alert/warning messages

# TTS provider: "elevenlabs" (default) or "openai"
TTS_PROVIDER=elevenlabs

# Local storage for call metadata and recordings
LOCAL_STORAGE_DIR=local_storage

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
